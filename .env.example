# Requisor Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Application Environment
NODE_ENV=development

# Application Domain (REQUIRED)
# For development: http://localhost:8080 (or your dev URL)
# For production: your custom domain (https://yourapp.example.com)
APP_DOMAIN=http://localhost:8080
APP_PROTOCOL=http

# Server Ports
PORT=5000
CREWAI_PORT=8000
VITE_PORT=5173

# Vite Proxy (for development only)
VITE_PROXY_TARGET=http://localhost:5000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database (automatically provided by Replit for database projects)
# DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# AI SERVICES
# =============================================================================

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Anthropic Claude API (optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# CrewAI Service URL (usually localhost in development)
CREWAI_URL=http://localhost:8000

# =============================================================================
# EMAIL SERVICES
# =============================================================================

# SendGrid for Email Services (optional)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================

# Stripe for Subscription Management (optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Session Secret for Express Sessions
SESSION_SECRET=your-super-secret-session-key-here

# Mastodon OAuth Encryption Key
MASTODON_ENCRYPTION_KEY=your-mastodon-encryption-key-here

# =============================================================================
# SOCIAL MEDIA INTEGRATIONS
# =============================================================================

# Mastodon Configuration
MASTODON_WEBSITE=https://requisor.io

# =============================================================================
# PROJECT MANAGEMENT INTEGRATIONS
# =============================================================================

# Jira Integration (optional)
JIRA_CLIENT_ID=your-jira-client-id-here
JIRA_CLIENT_SECRET=your-jira-client-secret-here
JIRA_AUTH_URL=https://auth.atlassian.com/authorize
JIRA_TOKEN_URL=https://auth.atlassian.com/oauth/token
JIRA_API_URL=https://api.atlassian.com/ex/jira
JIRA_RESOURCES_URL=https://api.atlassian.com/oauth/token/accessible-resources

# Smartsheet Integration (optional)
SMARTSHEET_CLIENT_ID=your-smartsheet-client-id-here
SMARTSHEET_CLIENT_SECRET=your-smartsheet-client-secret-here
SMARTSHEET_API_URL=https://api.smartsheet.com/2.0
SMARTSHEET_AUTH_URL=https://app.smartsheet.com/b/authorize
SMARTSHEET_TOKEN_URL=https://api.smartsheet.com/2.0/token

# Asana Integration (optional)
ASANA_CLIENT_ID=your-asana-client-id-here
ASANA_CLIENT_SECRET=your-asana-client-secret-here
ASANA_API_URL=https://app.asana.com/api/1.0
ASANA_AUTH_URL=https://app.asana.com/oauth2/authorize
ASANA_TOKEN_URL=https://app.asana.com/oauth2/token

# Monday.com Integration (optional)
MONDAY_CLIENT_ID=your-monday-client-id-here
MONDAY_CLIENT_SECRET=your-monday-client-secret-here
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_AUTH_URL=https://auth.monday.com/oauth2/authorize
MONDAY_TOKEN_URL=https://auth.monday.com/oauth2/token

# =============================================================================
# EXTERNAL SERVICE URLS
# =============================================================================

# Atlassian Service URLs
ATLASSIAN_TOKEN_URL=https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SIGNUP_URL=https://www.atlassian.com/try/cloud/signup

# =============================================================================
# MEDIA & FILE STORAGE
# =============================================================================

# Media Storage Configuration
MEDIA_BASE_URL=
UPLOADS_DIR=./uploads

# =============================================================================
# QUICK SETUP GUIDE
# =============================================================================

# REQUIRED FOR BASIC FUNCTIONALITY:
# 1. APP_DOMAIN - Set to your current Replit domain
# 2. OPENAI_API_KEY - Get from https://platform.openai.com/api-keys
# 3. SESSION_SECRET - Generate a random string (e.g., use uuidgen or similar)

# OPTIONAL BUT RECOMMENDED:
# 4. SENDGRID_API_KEY - For email notifications
# 5. STRIPE_SECRET_KEY & STRIPE_PUBLISHABLE_KEY - For subscription features

# INTEGRATION SETUP (as needed):
# 6. Configure integration client IDs and secrets for each service you want to use
# 7. Update domain URLs if using custom domains in production

# =============================================================================
# NOTES
# =============================================================================

# - Lines starting with # are comments and will be ignored
# - Never commit your actual .env file to version control
# - Keep your API keys secure and rotate them regularly
# - Use different keys for development and production environments
# - Some services (like DATABASE_URL) are automatically provided by Replit